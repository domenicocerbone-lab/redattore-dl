# Chiave dell'API Claude (https://platform.claude.com/settings/keys)
ANTHROPIC_API_KEY=

# Obbligatoria online (npm start): password dell'amministratore. Senza, in sviluppo l'accesso è libero.
# REDATTORE_PASSWORD_ADMIN=

# Facoltativi
# REDATTORE_NOME_ADMIN=Amministratore   # come compare l'amministratore nella pagina utilizzo
# REDATTORE_URL=https://…              # indirizzo pubblico usato nei link personali (di solito si ricava da solo)
# REDATTORE_MODELLO=claude-opus-5-5
# REDATTORE_MODELLO_TABELLE=claude-sonnet-5-5   # lettura di computo e cronoprogramma lunghi
# REDATTORE_SFORZO=high        # low | medium | high | xhigh | max
# REDATTORE_FORMATO=prompt     # salta l'output strutturato (di solito lo decide da solo se l'API rifiuta lo schema)
# PORT=5173
# REDATTORE_DATI=data          # cartella di conversazioni e foto
